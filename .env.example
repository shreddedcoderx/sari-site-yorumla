# Production: absolute HTTPS public origin. Local development can omit this.
APP_URL=https://your-domain.example
# Grant admin to an existing account using node admin.mjs email@example.com
PORT=3000
DATA_DIR=./data
# Explicitly enable only for local previews; production rejects demo mode.
DEMO_DATA=false
# Enable only when the app is reachable exclusively through a reverse proxy
# that sets or appends the real client IP to X-Forwarded-For.
TRUST_PROXY=false
